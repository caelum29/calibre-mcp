{
  "name": "calibre-mcp",
  "version": "0.12.0",
  "description": "The most capable Calibre MCP server — full read/write tool surface plus library- and book-scoped semantic search.",
  "type": "module",
  "license": "MIT",
  "author": "Artem Sorochynskyi <caelum29@gmail.com> (https://github.com/caelum29)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caelum29/calibre-mcp.git"
  },
  "homepage": "https://github.com/caelum29/calibre-mcp#readme",
  "bugs": "https://github.com/caelum29/calibre-mcp/issues",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "calibre",
    "ebooks",
    "epub",
    "semantic-search",
    "claude"
  ],
  "mcpName": "io.github.caelum29/calibre-mcp",
  "bin": {
    "calibre-mcp": "dist/run-stdio.js"
  },
  "files": [
    "dist",
    "scripts/pymupdf_extract.py"
  ],
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "build": "node scripts/gen-widgets.mjs && tsc -p tsconfig.json",
    "dev": "tsx watch src/run-stdio.ts",
    "start": "node dist/run-stdio.js",
    "inspect": "pnpm build && mcp-inspector node dist/run-stdio.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:model": "RUN_MODEL_TESTS=1 vitest run test/semantic/embedder.integration.test.ts",
    "test:calibre": "RUN_CALIBRE_TESTS=1 vitest run test/integration/merge.live.test.ts",
    "eval": "node --import tsx test/eval/retrieval/run.ts",
    "reindex": "node --import tsx scripts/reindex.ts",
    "versions:check": "node scripts/check-versions.mjs",
    "catalog": "pnpm build && node scripts/gen-tool-catalog.mjs",
    "catalog:check": "node scripts/gen-tool-catalog.mjs --check",
    "widgets": "node scripts/gen-widgets.mjs",
    "widgets:check": "node scripts/gen-widgets.mjs --check",
    "prepublishOnly": "pnpm run versions:check && pnpm run build && pnpm run test",
    "pack:mcpb": "node scripts/pack-mcpb.mjs",
    "pack:mcpb:dev": "node scripts/pack-mcpb.mjs --dev",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.{ts,mjs,js}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --fix"
    ],
    "*.{json,yml,yaml}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@modelcontextprotocol/server": "^2.4.0",
    "open": "^11.0.1",
    "snowball-stemmers": "^0.6.0",
    "zod": "4.6.7"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "4.3.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/inspector": "2.12.0",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "4.1.9",
    "ajv": "8.20.0",
    "husky": "9.1.7",
    "knip": "6.43.0",
    "lint-staged": "17.6.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
