{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-console": "error",
    "complexity": ["warn", 20],
    "max-depth": ["warn", 4],
    "max-lines": [
      "warn",
      {
        "max": 500,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "max-params": ["warn", 4],
    "typescript/no-import-type-side-effects": "error"
  },
  "overrides": [
    {
      "files": ["test/**/*.ts", "scripts/**/*.mjs", "vitest.config.ts"],
      "rules": {
        "no-console": "off",
        "max-lines": "off"
      }
    },
    {
      "files": ["src/tools/**/*.ts"],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "name": "RegExp",
            "message": "Tool args are model-supplied: compile regex via compileUserRegex() in src/tools/user-regex.ts (PCRE inline flags, actionable errors, #30). Use a regex literal for static patterns."
          }
        ]
      }
    },
    {
      "files": ["src/tools/user-regex.ts"],
      "rules": {
        "no-restricted-globals": "off"
      }
    },
    {
      "files": ["src/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "node:child_process",
                "message": "Spawn subprocesses via src/calibre/spawn.ts: it bounds the timeout and kills the whole process group (#13, #145, #219)."
              },
              {
                "name": "child_process",
                "message": "Spawn subprocesses via src/calibre/spawn.ts: it bounds the timeout and kills the whole process group (#13, #145, #219)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/calibre/spawn.ts", "src/calibre/extract.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "ignorePatterns": ["dist/**", "dist-mcpb/**", "build/**", "coverage/**", "test/eval/retrieval/reports/**"]
}
