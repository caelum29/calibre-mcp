# Editor defaults aligned with oxfmt (.oxfmtrc.json) so IDE indent guides/formatter match CI formatting.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
max_line_length = 120
trim_trailing_whitespace = true

[*.md]
max_line_length = off
trim_trailing_whitespace = false
